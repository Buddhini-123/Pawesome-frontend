# ACCEPTANCE CRITERIA
acceptance_criteria:
  admin_table_columns:
    - loyalty_card: "Loyalty Card Number column displays card number or 'No Card'"
    - points: "Points column displays formatted points with thousand separators"
    - tier: "Tier column displays color-coded badge (Bronze/Silver/Gold/Platinum)"
    - sorting: "Table can be sorted by points column (ascending/descending)"

  data_fetching:
    - fetch_all: "Loyalty data fetched for all users on component mount"
    - async_handling: "Async data fetch handled properly with async/await"
    - error_handling: "Failed loyalty fetch doesn't break admin table"
    - performance: "Data fetching doesn't cause performance issues with many users"

  tier_badges:
    - bronze: "Bronze tier badge styled with orange/brown colors"
    - silver: "Silver tier badge styled with gray/silver colors"
    - gold: "Gold tier badge styled with yellow/gold colors"
    - platinum: "Platinum tier badge styled with purple/indigo colors"

  ui_states:
    - loading: "Loading indicator shown while fetching loyalty data"
    - no_card: "Users without loyalty cards show 'No Card' or '-'"
    - formatting: "Points displayed with commas (e.g., 5,250 not 5250)"
    - responsive: "Loyalty columns display correctly on different screen sizes"

  empty_states:
    - no_loyalty_users: "Table displays correctly when no users have loyalty cards"
    - data_fetch_fail: "Graceful handling if loyalty service is unavailable"

  validation_rules:
    - non_negative: "Points displayed are never negative"
    - valid_tiers: "Only valid tier values (BRONZE/SILVER/GOLD/PLATINUM) displayed"
    - card_format: "Loyalty card numbers displayed in consistent format"

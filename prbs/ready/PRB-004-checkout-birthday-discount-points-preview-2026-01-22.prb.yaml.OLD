    changelog_required: true
    pr_required: false
    merge_strategy: "direct_commit"
    release_automation: false
    auto_merge: false
    coordination_required: false
    breaking_change_assessment: false

  enforcement_rules:
    - "ALL 9 execution steps must be completed in order"
    - "NO bypass language or skip patterns allowed"
    - "MANDATORY git workflow compliance per project configuration"
    - "REQUIRED documentation updates for every change"
    - "VERSION bump mandatory for all modifications"
    - "TypeScript compilation must pass before commit"
    - "Manual testing of birthday discount and points calculation required"

# MCP Operations Extension Points
mcp_operations:
  memory:
    condition: false
    provider: "file-based"
    operations:
      - action: store_learning
        topic: "checkout-enhancements"
        content: "Birthday discount detection and points preview calculation in e-commerce checkout"
    fallback: "file-based"

  issue_tracking:
    condition: false
    provider: "file-based"
    operations: []
    fallback: "file-based"

  documentation:
    condition: false
    provider: "file-based"
    operations: []
    fallback: "file-based"

# EXECUTION CHECKLIST
execution_checklist: |
  ☐ Step 1 - Knowledge: Existing checkout patterns identified (discount state, pricing breakdown)
  ☐ Step 2 - Implementation: Birthday detection added, discount calculation implemented, points preview added
  ☐ Step 3 - Integration: Auth, loyalty constants, pricing calculations integrated
  ☐ Step 4 - Review: Birthday logic verified, points calculation tested, TypeScript passed
  ☐ Step 5 - Version: package.json version bumped (0.1.3 → 0.2.0)
  ☐ Step 6 - Documentation: CHANGELOG updated, inline comments added
  ☐ Step 7 - Git Commit: Changes committed with descriptive message
  ☐ Step 8 - Git Push: Changes pushed to remote branch bugx/issue-fix
  ☐ Step 9 - Completion: All deliverables verified, next steps documented

# ACCEPTANCE CRITERIA
acceptance_criteria:
  birthday_discount:
    - detection: "Birthday detected when today's month/day matches user.birthDate month/day"
    - calculation: "10% discount calculated from subscriptionSubtotal"
    - display: "Birthday discount shown as separate line item with celebration icon"
    - messaging: "Birthday celebration message displayed when discount applied"
    - validation: "No discount if user.birthDate is missing/null/invalid"
    - date_logic: "Comparison ignores year and time (month/day only)"

  points_preview:
    - calculation: "Points = Math.floor(finalTotalAfterDiscounts / 100)"
    - formula: "Uses 100 LKR = 1 point ratio from LOYALTY_CONSTANTS"
    - display: "Preview shown in Order Summary: 'You will earn X points with this order'"
    - accuracy: "Calculation includes all discounts (birthday, coupon, loyalty)"
    - styling: "Clear, prominent display with points icon/badge"

  pricing_integration:
    - discount_stacking: "Birthday discount works correctly with coupon/loyalty discounts"
    - total_calculation: "Final total = subtotal - couponDiscount - birthdayDiscount - loyaltyDiscount + tax + shipping"
    - breakdown: "All discounts shown as separate line items"
    - accuracy: "No calculation errors or rounding issues"

  edge_cases:
    - no_birthday: "No discount applied if user.birthDate is null/undefined"
    - invalid_date: "Graceful handling of invalid birthDate values"
    - leap_year: "Feb 29 birthdays handled correctly (show discount on Feb 28 in non-leap years OR only on Feb 29)"
    - timezone: "Birthday detection works regardless of user timezone"

  ui_validation:
    - no_layout_shift: "Adding discount doesn't cause layout jumps"
    - loading_state: "Graceful loading if user data delayed"
    - error_handling: "Checkout still works if birthday calculation fails"
    - responsive: "Birthday discount and points preview display correctly on mobile/tablet/desktop"

  empty_states:
    - no_birthday_set: "No birthday discount shown if user hasn't set birthDate"
    - not_birthday: "No birthday message shown when it's not user's birthday"
    - zero_points: "Handle case where order total results in 0 points earned"
